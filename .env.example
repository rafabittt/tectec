# Copie este arquivo para .env (na mesma pasta) e cole sua chave da API do Higgsfield.
# O .env está no .gitignore: ele nunca vai para o GitHub.
#
# Onde pegar: https://cloud.higgsfield.ai → API Keys → Create. A chave vem em duas partes:
HIGGSFIELD_API_KEY_ID=cole-aqui-o-key-id
HIGGSFIELD_API_KEY_SECRET=cole-aqui-o-key-secret
